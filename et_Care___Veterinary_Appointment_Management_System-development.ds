							View Record   	   
    					)
     				)
				)

				detailview
				(
					layout
					(
						datablock1
						(
							fields
							(
								Doctor_ID as "Doctor ID"
								Doctor_Name as "Doctor Name"
								Specialization
								Phone_Number as "Phone"
								Email
								Available_Days as "Available Days"
								Consultation_Fee as "Consultation Fee"
